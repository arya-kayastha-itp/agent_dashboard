PORT=4000
CORS_ORIGIN=http://localhost:5174

# Optional — powers the "Regenerate with AI" narrative on the agent Insights
# panel. Without it, that button returns a clean "not configured" error and
# the app falls back to the templated (non-AI) narrative.
ANTHROPIC_API_KEY=

# --- Databricks (the live datastore — see backend/README.md) ---
# Personal access tokens are per-user — generate your own under Databricks
# User Settings > Developer > Access tokens, and get USE CATALOG / USE SCHEMA /
# CREATE TABLE / MODIFY / SELECT granted on the catalog+schema below before
# running migrate:databricks / seed:databricks.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_HTTP_PATH=
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=

# --- Postgres (legacy — only read by scripts/backup-db.js, scripts/restore-db.js,
# and the one-time src/db/copy-postgres-to-databricks.js script. The running
# app no longer talks to Postgres.) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agent_dashboard
